[package]
name = "shadcn-egui-font-inter"
description = "Inter for shadcn-egui"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license = "MIT AND OFL-1.1"
repository.workspace = true
documentation = "https://docs.rs/shadcn-egui-font-inter"
readme = "README.md"
keywords = ["egui", "shadcn", "font", "inter"]
categories = ["gui"]
include = ["src/**", "fonts/**", "LICENSE*", "README*"]

[dependencies]
shadcn-egui-core.workspace = true
