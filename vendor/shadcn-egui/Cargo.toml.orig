[package]
name = "shadcn-egui"
description = "The shadcn/ui design system for egui: styles, palettes, presets and components"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
readme = "../../README.md"
keywords = ["egui", "shadcn", "gui", "theme", "design-system"]
categories = ["gui"]
include = ["src/**", "LICENSE*", "README*"]

[package.metadata.docs.rs]
all-features = true

# Keep the runtime dependency surface minimal: these propagate to every
# consumer. The library only needs egui and egui_extras' StripBuilder/Size
# (no loaders, no features). Heavier crates (eframe, egui_kittest, wgpu) are
# dev-only.
[dependencies]
egui.workspace = true
egui_extras.workspace = true
log.workspace = true
skrifa.workspace = true
shadcn-egui-core.workspace = true
shadcn-egui-font-inter.workspace = true
shadcn-egui-icons-lucide.workspace = true
shadcn-egui-icons-tabler = { workspace = true, optional = true }
shadcn-egui-icons-phosphor = { workspace = true, optional = true }
shadcn-egui-icons-remixicon = { workspace = true, optional = true }
shadcn-egui-icons-hugeicons = { workspace = true, optional = true }

# fontgen writes the optional font dependencies as [dependencies.<crate>]
# subtables and then opens [features]; the icon features below belong to
# that table.
# BEGIN fontgen
# Generated by tools/fontgen from tools/fontgen/FONTS.tsv; do not edit.

[dependencies.shadcn-egui-font-noto-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-nunito-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-figtree]
workspace = true
optional = true

[dependencies.shadcn-egui-font-roboto]
workspace = true
optional = true

[dependencies.shadcn-egui-font-raleway]
workspace = true
optional = true

[dependencies.shadcn-egui-font-dm-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-public-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-outfit]
workspace = true
optional = true

[dependencies.shadcn-egui-font-jetbrains-mono]
workspace = true
optional = true

[dependencies.shadcn-egui-font-geist]
workspace = true
optional = true

[dependencies.shadcn-egui-font-geist-mono]
workspace = true
optional = true

[dependencies.shadcn-egui-font-lora]
workspace = true
optional = true

[dependencies.shadcn-egui-font-merriweather]
workspace = true
optional = true

[dependencies.shadcn-egui-font-playfair-display]
workspace = true
optional = true

[dependencies.shadcn-egui-font-noto-serif]
workspace = true
optional = true

[dependencies.shadcn-egui-font-roboto-slab]
workspace = true
optional = true

[dependencies.shadcn-egui-font-oxanium]
workspace = true
optional = true

[dependencies.shadcn-egui-font-manrope]
workspace = true
optional = true

[dependencies.shadcn-egui-font-space-grotesk]
workspace = true
optional = true

[dependencies.shadcn-egui-font-montserrat]
workspace = true
optional = true

[dependencies.shadcn-egui-font-ibm-plex-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-source-sans-3]
workspace = true
optional = true

[dependencies.shadcn-egui-font-instrument-sans]
workspace = true
optional = true

[dependencies.shadcn-egui-font-eb-garamond]
workspace = true
optional = true

[dependencies.shadcn-egui-font-instrument-serif]
workspace = true
optional = true

[features]
font-noto-sans = ["dep:shadcn-egui-font-noto-sans"]
font-nunito-sans = ["dep:shadcn-egui-font-nunito-sans"]
font-figtree = ["dep:shadcn-egui-font-figtree"]
font-roboto = ["dep:shadcn-egui-font-roboto"]
font-raleway = ["dep:shadcn-egui-font-raleway"]
font-dm-sans = ["dep:shadcn-egui-font-dm-sans"]
font-public-sans = ["dep:shadcn-egui-font-public-sans"]
font-outfit = ["dep:shadcn-egui-font-outfit"]
font-jetbrains-mono = ["dep:shadcn-egui-font-jetbrains-mono"]
font-geist = ["dep:shadcn-egui-font-geist"]
font-geist-mono = ["dep:shadcn-egui-font-geist-mono"]
font-lora = ["dep:shadcn-egui-font-lora"]
font-merriweather = ["dep:shadcn-egui-font-merriweather"]
font-playfair-display = ["dep:shadcn-egui-font-playfair-display"]
font-noto-serif = ["dep:shadcn-egui-font-noto-serif"]
font-roboto-slab = ["dep:shadcn-egui-font-roboto-slab"]
font-oxanium = ["dep:shadcn-egui-font-oxanium"]
font-manrope = ["dep:shadcn-egui-font-manrope"]
font-space-grotesk = ["dep:shadcn-egui-font-space-grotesk"]
font-montserrat = ["dep:shadcn-egui-font-montserrat"]
font-ibm-plex-sans = ["dep:shadcn-egui-font-ibm-plex-sans"]
font-source-sans-3 = ["dep:shadcn-egui-font-source-sans-3"]
font-instrument-sans = ["dep:shadcn-egui-font-instrument-sans"]
font-eb-garamond = ["dep:shadcn-egui-font-eb-garamond"]
font-instrument-serif = ["dep:shadcn-egui-font-instrument-serif"]
fonts-all = [
    "font-noto-sans",
    "font-nunito-sans",
    "font-figtree",
    "font-roboto",
    "font-raleway",
    "font-dm-sans",
    "font-public-sans",
    "font-outfit",
    "font-jetbrains-mono",
    "font-geist",
    "font-geist-mono",
    "font-lora",
    "font-merriweather",
    "font-playfair-display",
    "font-noto-serif",
    "font-roboto-slab",
    "font-oxanium",
    "font-manrope",
    "font-space-grotesk",
    "font-montserrat",
    "font-ibm-plex-sans",
    "font-source-sans-3",
    "font-instrument-sans",
    "font-eb-garamond",
    "font-instrument-serif",
]
# END fontgen
icons-tabler = ["dep:shadcn-egui-icons-tabler"]
icons-phosphor = ["dep:shadcn-egui-icons-phosphor"]
icons-remixicon = ["dep:shadcn-egui-icons-remixicon"]
icons-hugeicons = ["dep:shadcn-egui-icons-hugeicons"]
icons-all = ["icons-tabler", "icons-phosphor", "icons-remixicon", "icons-hugeicons"]

[dev-dependencies]
eframe = "0.34"
egui_kittest = { version = "0.34", features = ["wgpu", "snapshot"] }
# Composes the README's settings image from two snapshot renders; already
# in the tree through egui_kittest.
image = { version = "0.25", default-features = false }
# Tests compare against a heading font that differs from the body font.
shadcn-egui-font-oxanium.workspace = true

# The gallery example's browser entry point; scripts/build-web-gallery.sh
# runs the wasm-bindgen CLI of the version Cargo.lock pins for this crate.
[target.'cfg(target_arch = "wasm32")'.dev-dependencies]
wasm-bindgen = "0.2"
wasm-bindgen-futures = "0.4"
web-sys = { version = "0.3", features = ["Document", "Element", "HtmlCanvasElement", "Location", "UrlSearchParams", "Window"] }

[[example]]
name = "settings"

[[example]]
name = "gallery"
required-features = ["fonts-all", "icons-all"]
# The tests of initial_state run with cargo test --all-features.
test = true

[[example]]
name = "bench_frame"
