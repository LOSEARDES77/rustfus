# Arch Linux package from a prebuilt release binary.
# Usage: copy to an empty dir, replace @VERSION@, then
#   REPO=/path/to/rustfus BIN=$REPO/target/<triple>/release/rustfus makepkg
pkgname=rustfus
pkgver=@VERSION@
pkgrel=1
pkgdesc="Rufus-style bootable USB creator with an egui GUI"
arch=('x86_64')
url="https://github.com/LOSEARDES77/rustfus"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'libglvnd' 'polkit')
optdepends=('curl: GRUB/Syslinux/Fido downloads'
            'ntfs-3g: NTFS formatting'
            'exfatprogs: exFAT formatting'
            'udftools: UDF formatting'
            'powershell-bin: Windows ISO download (Fido)'
            'vulkan-icd-loader: Vulkan rendering')
options=('!strip' '!debug')

package() {
  cd "$REPO"
  install -Dm755 "$BIN" "$pkgdir/usr/bin/rustfus"
  install -Dm644 packaging/rustfus.desktop "$pkgdir/usr/share/applications/rustfus.desktop"
  install -Dm644 packaging/io.github.rustfus.policy "$pkgdir/usr/share/polkit-1/actions/io.github.rustfus.policy"
  install -Dm644 res/rustfus.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rustfus.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/rustfus/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/doc/rustfus/THIRD_PARTY_NOTICES.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/rustfus/README.md"
}
